# syntax=docker/dockerfile:1
FROM continuumio/miniconda3:latest

SHELL ["/bin/bash", "-lc"]

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/DSE
ENV PYTHONPATH=/opt/DSE

# Create conda env (ONLY change is python version)
RUN conda create -y -n device_experiments python=3.12 && \
    conda clean -afy

ENV PATH=/opt/conda/envs/device_experiments/bin:$PATH

# Copy requirements from repo root
COPY requirements.txt /opt/DSE/requirements.txt

# Install dependencies
RUN conda run -n device_experiments python -m pip install --upgrade pip && \
    conda run -n device_experiments pip install -r /opt/DSE/requirements.txt

COPY src/ /opt/DSE/src/
COPY circuits/ /opt/DSE/circuits/
# Copy entrypoint from src/
COPY src/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]