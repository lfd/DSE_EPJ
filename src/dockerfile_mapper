# syntax=docker/dockerfile:1
FROM continuumio/miniconda3:latest

SHELL ["/bin/bash", "-lc"]

# System deps (keep what you really need)
RUN apt-get update && apt-get install -y --no-install-recommends \
    git ca-certificates \
    build-essential python3-dev \
    libffi-dev libssl-dev \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/DSE
ENV PYTHONPATH=/opt/DSE

# Create conda env
RUN conda create -y -n mapper_experiments python=3.12 && \
    conda clean -afy

ENV PATH=/opt/conda/envs/mapper_experiments/bin:$PATH

# Copy mapper requirements
COPY requirements_mapper.txt /opt/DSE/requirements_mapper.txt

# Install dependencies into mapper env
RUN conda run -n mapper_experiments python -m pip install --upgrade pip && \
    conda run -n mapper_experiments pip install -r /opt/DSE/requirements_mapper.txt

# Copy code + data
COPY src/ /opt/DSE/src/
COPY circuits/ /opt/DSE/circuits/

# Copy mapper entrypoint
COPY src/entrypoint_mapper.sh /entrypoint_mapper.sh
RUN chmod +x /entrypoint_mapper.sh

ENTRYPOINT ["/entrypoint_mapper.sh"]